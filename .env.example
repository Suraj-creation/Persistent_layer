# Optional pretrained extraction. Leave credentials empty for rule-based fallback.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# auto enables model-backed assessments. rules disables inference; saved records remain readable.
LEARNER_EXTRACTOR=auto
# Optional; default is the repository's data/learner_state.db.
# LEARNER_DB_PATH=C:/path/to/learner_state.db
# Training-compatible override, takes precedence over LEARNER_DB_PATH when both are set.
# LEARNER_STATE_DB_PATH=/path/to/learner_state.db

# Fraction research sandbox defaults to offline rules and deterministic replies.
EVIDENCE_EXTRACTOR_MODE=rules
TUTOR_RESPONSE_MODE=deterministic
# Vite defaults to the API port below. Set in the frontend shell to override it.
# API_PROXY_TARGET=http://127.0.0.1:8002

# Raw NLP trace retention, enforced on execution start and trace reads (learner evidence is retained).
NLP_TRACE_RETENTION_DAYS=30
