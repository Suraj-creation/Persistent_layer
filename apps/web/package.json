  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "tailwindcss": "3.4.17"
  }
}
